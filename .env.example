TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional additional private recipients, comma-separated. Used by the Moguta deployment.
TELEGRAM_COPY_CHAT_IDS=
HOST=127.0.0.1
PORT=8766
ALLOWED_ORIGINS=http://127.0.0.1:8766,http://localhost:8766
# Production: https://homeporte.example (no trailing slash)
# DATA_DIR=/var/lib/homeporte
# Only enable behind the supplied reverse proxy, never on an exposed port.
TRUST_PROXY=0
